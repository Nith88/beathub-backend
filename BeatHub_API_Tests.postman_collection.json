        {
          "name": "Get Songs with Cursor Pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.code.should.eql(200);",
                  "});",
                  "",
                  "pm.test('Response has cursor pagination structure', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success').that.equals(true);",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData).to.have.property('pagination');",
                  "});",
                  "",
                  "pm.test('Pagination object has required fields', function() {",
                  "    var jsonData = pm.response.json();",
                  "    var pagination = jsonData.pagination;",
                  "    pm.expect(pagination).to.have.property('nextCursor');",
                  "    pm.expect(pagination).to.have.property('hasMore');",
                  "    pm.expect(pagination).to.have.property('limit');",
                  "    pm.expect(pagination).to.have.property('count');",
                  "});",
                  "",
