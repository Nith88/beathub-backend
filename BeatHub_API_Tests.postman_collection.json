    {
      "name": "Songs - Pagination",
      "item": [
        {
          "name": "Get Songs with Pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.code.should.eql(200);",
                  "});",
                  "",
                  "pm.test('Response has metadata', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('metadata');",
                  "    pm.expect(jsonData.metadata).to.have.property('currentPage');",
                  "    pm.expect(jsonData.metadata).to.have.property('totalPages');",
                  "    pm.expect(jsonData.metadata).to.have.property('totalDocuments');",
                  "    pm.expect(jsonData.metadata).to.have.property('hasNext');",
                  "    pm.expect(jsonData.metadata).to.have.property('hasPrev');",
                  "});",
                  "",
                  "pm.test('Response has data array', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Array.isArray(jsonData.data)).to.be.true;",
                  "});",
                  "",
                  "pm.test('Page 1 should have hasPrev false', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.metadata.currentPage).to.eql(1);",
                  "    pm.expect(jsonData.metadata.hasPrev).to.be.false;",
                  "});",
                  "",
                  "pm.test('Respects page and limit parameters', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.metadata.currentPage).to.eql(1);",
                  "    pm.expect(jsonData.data.length).to.be.at.most(10);",
                  "});"
                ]
              }
            }
